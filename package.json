{
  "name": "tmo-validation",
  "version": "1.0.0",
  "private": true,
  "description": "TMO validation monorepo for Core, schemas, and independently versioned application profiles.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "quality": "npm run quality --workspaces --if-present",
    "test:core": "npm run test --workspace=@tmo/core",
    "test:le": "npm run test --workspace=@tmo/le-profile",
    "test:ca": "npm run test --workspace=@tmo/ca-profile --if-present",
    "test:ed": "npm run test --workspace=@tmo/ed-profile --if-present"
  }
}
